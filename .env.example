# Copy to .env next to docker-compose.yml if you want to override defaults.

OLLAMA_MODEL=llama3.2:3b
JWT_SECRET=dev-change-me-askdoc-secret-key!!
ADMIN_EMAIL=admin@askdoc.local
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin12345
# Fallback used by the Next server when API_URL is unset.
NEXT_PUBLIC_API_URL=http://localhost:8000
# Public API prefix shared by nginx, the Next app, and FastAPI.
API_PREFIX=/api/v1
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANKER_MODEL=BAAI/bge-reranker-base
