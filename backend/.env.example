# Copy to .env and adjust as needed.

APP_NAME=AskDoc
DEBUG=false

# Local data directory (uploads, SQLite, Chroma)
DATA_DIR=data

# Hugging Face models (downloaded on first use)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANKER_MODEL=BAAI/bge-reranker-base

# Ollama (must be running locally)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Chunking / retrieval
CHUNK_SIZE=900
CHUNK_OVERLAP=150
RETRIEVE_K=8
RERANK_K=6

# Load BGE models in the background when the API starts
PRELOAD_MODELS=true

# OCR fallback for scanned PDFs (requires Tesseract). Off by default; digital PDFs are much faster.
OCR_ENABLED=false
OCR_LANG=eng+fra
OCR_MIN_CHARS=40

MAX_UPLOAD_MB=50
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:5173"]
