worker_processes auto;

events {
    worker_connections 1024;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    server_tokens off;
    client_max_body_size 64m;
    sendfile on;
    keepalive_timeout 65s;
    client_header_timeout 15s;
    client_body_timeout 60s;

    gzip on;
    gzip_vary on;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_proxied any;
    gzip_types text/plain text/css application/json application/javascript text/javascript application/xml image/svg+xml;

    # Hashed Next.js assets only. API and HTML stay uncached.
    proxy_cache_path /var/cache/nginx/static levels=1:2 keys_zone=next_static:10m max_size=200m inactive=7d use_temp_path=off;

    # Docker's DNS. Names are resolved per request, so a restarted container is picked up.
    resolver 127.0.0.11 valid=10s ipv6=off;

    map $http_upgrade $connection_upgrade {
        default upgrade;
        ""      close;
    }

    map $cookie_askdoc_session $session_bearer {
        ""      "";
        default "Bearer $cookie_askdoc_session";
    }

    map $http_authorization $forward_authorization {
        ""      $session_bearer;
        default $http_authorization;
    }

    map $scheme $hsts {
        https   "max-age=63072000; includeSubDomains";
        default "";
    }

    server {
        listen 80;

        set $frontend_upstream http://frontend:3000;
        set $backend_upstream http://backend:8000;

        include /etc/nginx/snippets/security.conf;
        include /etc/nginx/snippets/proxy.conf;
        add_header Cache-Control "private, no-cache" always;

        location = ${API_PREFIX}/ask/stream {
            include /etc/nginx/snippets/security.conf;
            include /etc/nginx/snippets/proxy.conf;
            proxy_pass $backend_upstream;
            proxy_buffering off;
            proxy_cache off;
            gzip off;
            proxy_set_header Authorization $forward_authorization;
            proxy_set_header Connection "";
            add_header Cache-Control "private, no-store" always;
            add_header X-Accel-Buffering "no" always;
        }

        location ~ ^${API_PREFIX}/(documents|collections)/[^/]+/messages/stream$ {
            include /etc/nginx/snippets/security.conf;
            include /etc/nginx/snippets/proxy.conf;
            proxy_pass $backend_upstream;
            proxy_buffering off;
            proxy_cache off;
            gzip off;
            proxy_set_header Authorization $forward_authorization;
            proxy_set_header Connection "";
            add_header Cache-Control "private, no-store" always;
            add_header X-Accel-Buffering "no" always;
        }

        location ${API_PREFIX}/ {
            include /etc/nginx/snippets/security.conf;
            include /etc/nginx/snippets/proxy.conf;
            proxy_pass $backend_upstream;
            proxy_set_header Authorization $forward_authorization;
            add_header Cache-Control "private, no-store" always;
        }

        location ^~ /_next/static/ {
            include /etc/nginx/snippets/security.conf;
            include /etc/nginx/snippets/proxy.conf;
            proxy_pass $frontend_upstream;
            proxy_cache next_static;
            proxy_cache_valid 200 7d;
            proxy_cache_lock on;
            add_header Cache-Control "public, max-age=31536000, immutable" always;
        }

        location /docs {
            proxy_pass $backend_upstream;
        }

        location /redoc {
            proxy_pass $backend_upstream;
        }

        location = /openapi.json {
            proxy_pass $backend_upstream;
        }

        location / {
            include /etc/nginx/snippets/proxy.conf;
            proxy_pass $frontend_upstream;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
        }
    }
}
